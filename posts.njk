---
layout: layout.njk
---

{% set grouped = collections.posts | groupByTag %}
{% for tag, posts in grouped %}
  <section>
    <h2>{{ tag }}</h2>
    <ul>
    {% for post in posts %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        <time datetime="{{ post.date | isodate }}">{{ post.date | readableDate }}</time>
      </li>
    {% endfor %}
    </ul>
  </section>
{% endfor %}